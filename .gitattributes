# Normalize line endings: LF in the repo and in checkouts.
# The server and CI are Linux; Windows checkouts must not introduce CRLF.
* text=auto eol=lf
Makefile text eol=lf
*.go text eol=lf

# Windows-only scripts, if any ever land, keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# The committed Gradle wrapper. The jar is binary, and the launcher script
# must keep LF even in a Windows checkout; gradlew.bat keeps CRLF above.
*.jar binary
android/gradlew text eol=lf
