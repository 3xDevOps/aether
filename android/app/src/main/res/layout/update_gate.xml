<?xml version="1.0" encoding="utf-8"?>
<!-- The Edge update gate: why the dashboard is gone, how the update installs,
     the URL it opens, and the ways out. Its padding is set with the window
     insets in MainActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/update_gate"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:clickable="true"
    android:fillViewport="true"
    android:padding="@dimen/edge_margin"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/update_gate_title"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/update_gate_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/update_gate_how"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_muted" />

        <TextView
            android:id="@+id/update_gate_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_muted"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/update_gate_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/error_text"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/update_gate_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/accent_fill"
            android:minHeight="48dp"
            android:textAllCaps="false"
            android:textColor="@color/on_accent" />

        <Button
            android:id="@+id/update_gate_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/update_check"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/update_gate_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_muted"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/update_gate_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/connection"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/update_gate_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/update_gate_copy"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
