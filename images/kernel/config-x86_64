# Aether guest kernel for Cloud Hypervisor, x86_64. A miniconfig: build.sh
# applies it with `make KCONFIG_ALLCONFIG=<this file> allnoconfig`, so every
# option not listed here is off, and fails if any line below is missing from
# the resulting .config.

CONFIG_LOCALVERSION="-aether"
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_X86_X2APIC=y
CONFIG_IA32_EMULATION=y
CONFIG_X86_VSYSCALL_EMULATION=y
CONFIG_LEGACY_VSYSCALL_XONLY=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
# Kernel hardening against a Default-tier uid-1000 agent escalating in the
# VM. RELOCATABLE and RANDOMIZE_BASE/MEMORY give KASLR when the kernel is
# booted as a bzImage; Cloud Hypervisor's PVH boot of the uncompressed
# vmlinux does not run the decompressor, so they take effect only through
# the bzImage path (see images/kernel/build.sh). The rest apply either way:
# zero-on-allocation, usercopy bounds, and a hardened/randomized SLUB
# freelist raise the bar for heap and copy-to/from-user exploits.
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_JUMP_LABEL=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PSI=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
