# /etc/aether-edge-update.env: settings of aether-edge-update
# (scripts/edge-update.sh), which reads this file on every run. Variables
# already in the environment are overridden. docs/edge.md, "Automatic
# updates", explains each value.

# The edge's relay origin. The updater compares the fingerprint served on
# <relay>/v1/edge before and after an update.
AETHER_EDGE_UPDATE_RELAY_URL=https://<relay-host>

# Defaults, shown for reference.
#AETHER_EDGE_UPDATE_CHANNEL=stable
#AETHER_EDGE_UPDATE_COMPOSE_DIR=/opt/aether-edge
#AETHER_EDGE_UPDATE_DIGEST_FILE=/opt/aether-edge/.env
#AETHER_EDGE_UPDATE_STATE=/var/lib/aether-edge-update
#AETHER_EDGE_UPDATE_SERVER_WAIT=120
#AETHER_EDGE_UPDATE_SERVER_TOLERANCE=0
