# /etc/aether-edge/aether-edge.env: options of aether-edge serve, read by
# packaging/systemd/aether-edge.service. Replace every <...> value. Each
# variable is also a flag (AETHER_EDGE_SERVER_DOMAIN is --server-domain),
# and a flag wins. docs/edge.md explains each value.

# Public URL of this edge. Clients, servers and browsers use it.
AETHER_EDGE_ORIGIN=https://<edge-host>

# Domain under which each server's dashboard is <server id>.<server-domain>.
# A wildcard DNS record for it points at this machine. Keep it on a
# registrable domain separate from the edge host's.
AETHER_EDGE_SERVER_DOMAIN=<server-domain>

# Contact address on the ACME account of the edge host's certificate.
AETHER_EDGE_ACME_EMAIL=<acme-contact-email>

# Bytes the relay may send per calendar month (UTC) before every relayed
# connection is paced to 256 KiB/s together. A plain byte count; 0 = none.
AETHER_EDGE_EGRESS_BUDGET=<egress-budget-bytes>

# OAuth client ids. The secrets are not set here: the unit loads
# /etc/aether-edge/github-client-secret and google-client-secret with
# LoadCredential= and sets AETHER_EDGE_GITHUB_CLIENT_SECRET_FILE and
# AETHER_EDGE_GOOGLE_CLIENT_SECRET_FILE. To not offer a provider, delete
# its id line here and do not create its secret file.
AETHER_EDGE_GITHUB_CLIENT_ID=<github-client-id>
AETHER_EDGE_GOOGLE_CLIENT_ID=<google-client-id>

# The unit sets these from its credentials. Set one yourself only when
# you run aether-edge without that unit.
#AETHER_EDGE_GITHUB_CLIENT_SECRET_FILE=<path to a file holding the secret>
#AETHER_EDGE_GOOGLE_CLIENT_SECRET_FILE=<path to a file holding the secret>
# The secret itself, instead of a file. A variable and a file for the same
# provider together are refused.
#AETHER_EDGE_GITHUB_CLIENT_SECRET=<github-client-secret>
#AETHER_EDGE_GOOGLE_CLIENT_SECRET=<google-client-secret>

# Defaults, shown for reference.
#AETHER_EDGE_LISTEN=:443
#AETHER_EDGE_METRICS_LISTEN=127.0.0.1:9464
#AETHER_EDGE_DATA=/var/lib/aether-edge
#AETHER_EDGE_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# Development only: plain HTTP on a loopback address, no certificates and no
# dashboard passthrough. AETHER_EDGE_ORIGIN must then be http://<that address>.
#AETHER_EDGE_DEV_LISTEN=127.0.0.1:8080
