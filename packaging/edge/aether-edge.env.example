# /etc/aether-edge/aether-edge.env: options of aether-edge serve, read by
# packaging/systemd/aether-edge.service. Replace every <...> value. Each
# variable is also a flag (AETHER_EDGE_PROXY_LISTEN is --proxy-listen), and
# a flag wins. docs/edge.md explains each value.

# The edge's two public URLs, on two host names. People sign in and
# clients call the API on the sign-in origin; OAuth callbacks go there.
# Servers enroll with, and clients connect through, the relay origin.
AETHER_EDGE_SIGNIN_ORIGIN=https://<signin-host>
AETHER_EDGE_RELAY_ORIGIN=https://<relay-host>

# Behind a reverse proxy on this host that terminates TLS for both host
# names, such as nginx with packaging/nginx/aether-edge.conf.example: plain
# HTTP on this loopback address, client addresses from the proxy's
# X-Forwarded-For. The origins above stay https://.
AETHER_EDGE_PROXY_LISTEN=127.0.0.1:8443

# Only when the proxy is not on this host, such as a proxy in another
# container: the networks it connects from, comma-separated. The address
# above may then be any address, and requests from any other peer are
# refused. docs/edge.md, "A proxy that is not on this host".
#AETHER_EDGE_TRUSTED_PROXIES=<proxy-network-cidr>

# Bytes the relay may send per calendar month (UTC) before every relayed
# connection is paced to 256 KiB/s together. A plain byte count; 0 = none.
AETHER_EDGE_EGRESS_BUDGET=<egress-budget-bytes>

# The GitHub OAuth app's client id. The secret is not set here: the unit
# loads /etc/aether-edge/github-client-secret with LoadCredential= and
# sets AETHER_EDGE_GITHUB_CLIENT_SECRET_FILE.
AETHER_EDGE_GITHUB_CLIENT_ID=<github-client-id>

# The unit sets this from its credential. Set it yourself only when you
# run aether-edge without that unit.
#AETHER_EDGE_GITHUB_CLIENT_SECRET_FILE=<path to a file holding the secret>
# The secret itself, instead of a file. The variable and the file
# together are refused.
#AETHER_EDGE_GITHUB_CLIENT_SECRET=<github-client-secret>

# Without a reverse proxy the edge terminates TLS on AETHER_EDGE_LISTEN
# with its own Let's Encrypt certificates: delete AETHER_EDGE_PROXY_LISTEN
# above, set the ACME contact below, and give the unit the drop-in that
# lets it bind :443 (docs/edge.md, "Without a reverse proxy").
#AETHER_EDGE_ACME_EMAIL=<acme-contact-email>
#AETHER_EDGE_LISTEN=:443
#AETHER_EDGE_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# Defaults, shown for reference.
#AETHER_EDGE_METRICS_LISTEN=127.0.0.1:9464
#AETHER_EDGE_DATA=/var/lib/aether-edge

# Development only: plain HTTP on a loopback address, no certificates.
# The origins must then be http:// on two loopback host names of that
# address, such as http://localhost:8080 and http://127.0.0.1:8080.
#AETHER_EDGE_DEV_LISTEN=127.0.0.1:8080
