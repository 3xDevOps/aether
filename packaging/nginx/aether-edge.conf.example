# /etc/nginx/conf.d/aether-edge.conf: nginx in front of aether-edge run
# with --proxy-listen 127.0.0.1:8443 (AETHER_EDGE_PROXY_LISTEN). Replace
# <signin-host> and <relay-host> with the host names of
# AETHER_EDGE_SIGNIN_ORIGIN and AETHER_EDGE_RELAY_ORIGIN. The certificate
# paths are where `sudo certbot certonly --nginx -d <host>` puts each
# host's certificate. docs/edge.md, "Behind a reverse proxy", explains
# each line.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name <signin-host>;
    ssl_certificate     /etc/letsencrypt/live/<signin-host>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<signin-host>/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8443;
        proxy_http_version 1.1;
        # The edge picks the origin by the host name.
        proxy_set_header Host $host;
        # Set, not appended: the address nginx accepted the connection
        # from replaces whatever the client sent.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name <relay-host>;
    ssl_certificate     /etc/letsencrypt/live/<relay-host>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<relay-host>/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
        # Servers and clients hold WebSockets here, and a relayed terminal
        # may send nothing for hours.
        proxy_read_timeout 7d;
        proxy_send_timeout 7d;
    }
}
